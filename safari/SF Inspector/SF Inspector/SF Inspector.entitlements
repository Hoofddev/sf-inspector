<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. The container app only tells the reader how to enable the
	     extension, so it needs nothing beyond the sandbox itself: no network, no files, no
	     hardware. Anything added here has to be justified to App Review, so it stays empty. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
