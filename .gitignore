# Safari build output
build/

# The Safari app project is source, not build output: it carries the signing settings,
# entitlements, versions and build phases the shipped app is made from, and it is no longer
# regenerated on every build. What is generated is the payload copied into it -- build-safari.sh
# rsyncs the built extension into Resources/ on each build -- and Xcode's per-user state.
safari/SF Inspector/SF Inspector Extension/Resources/
safari/**/xcuserdata/
safari/**/*.xcuserdatad/

# iCloud Drive sync-conflictkopieen ("naam 2.ext")
* [0-9].*

addon/_gallery.html

# App Store screenshots. Regenerated deterministically by tests/screenshots/store.capture.js
# (npx playwright test -c playwright.screenshots.config.js), so the PNGs are output, not source --
# and they are ~4MB that git would keep forever. The listing copy beside them is source, and is
# tracked, so this ignores the image directories rather than store-assets as a whole.
store-assets/screenshots/
store-assets/raw/
