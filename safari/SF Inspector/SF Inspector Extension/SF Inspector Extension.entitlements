<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The background worker calls the Salesforce REST and Metadata APIs on the reader's behalf.
	     It is an outgoing client only: nothing listens, so the server entitlement is deliberately
	     absent. The host permissions in manifest.json are what actually bound where it may go. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
